# =====
# Telegram Bot Configuration
# Конфигурация бота Telegram
# =====
BOT_TOKEN=your_telegram_bot_token_here
USE_LOCAL_API=true
TG_API_SERVER=http://127.0.0.1:8081
ERROR_CHANNEL_ID=-1001234567890
REPORT_CHANNEL_ID=-1009876543210

# =====
# VK API Configuration
# Конфигурация VK API
# =====
VK_TOKEN=your_vk_service_token_here

# =====
# Admin Configuration
# Конфигурация администратора
# =====
ADMIN_USER_ID=123456789

# =====
# Web Server Configuration
# Конфигурация веб-сервера
# =====
WEB_AUTH_TOKEN=your_secret_token_here

# MONITOR_INTERVAL=60
# CACHE_FLUSH_INTERVAL=10
# AVATAR_UPDATE_INTERVAL_HOURS=24
# AVATAR_CHECK_ON_MONITOR_CYCLES=60
# WEB_PORT=8080
# LOG_LEVEL=INFO
# REPORT_RATE_LIMIT_PER_HOUR=5
# VERIFY_SSL=true        # false — отключить проверку TLS (только для тестов)
